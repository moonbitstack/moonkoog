name = "moonbitstack/moonkoog"

version = "0.6.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonkoog"

license = "Apache-2.0"

keywords = [
  "koog",
  "agent",
  "llm",
  "tool-calling",
  "agent-framework",
  "state-graph",
  "workflow",
  "middleware",
  "multi-agent",
  "handoff",
  "supervisor",
  "swarm",
  "planner",
  "goap",
  "plan-and-execute",
  "react",
  "rag",
  "retrieval",
  "mcp",
  "model-context-protocol",
  "a2a",
  "agent-to-agent",
  "acp",
  "agent-client-protocol",
  "agent-protocol",
  "opentelemetry",
  "otel",
  "gen-ai",
  "observability",
  "tracing",
  "checkpoint",
  "human-in-the-loop",
  "skills",
  "moonbit",
]

description = "moonkoog — an agent framework for MoonBit: prebuilt agents and strategies over the moonstate graph engine, a middleware pipeline, planning, multi-agent composition, and the protocol adapters that put an agent behind MCP, A2A, ACP and the Agent Protocol."

import {
  "moonbitstack/moonmuse@0.1.1",
  "moonbitstack/moonstate@0.1.1",
  "moonbitstack/moonrag@0.1.1",
  "moonbitstack/moonmcp@0.1.12",
