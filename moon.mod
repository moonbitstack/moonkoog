  "moonbitstack/moonapi@0.17.11",
  "moonbitstack/moonjson@0.4.4",
  "moonbitstack/moonbase@0.4.5",
  "moonbitstack/moondate@0.1.7",
  "moonbitstack/moonknob@0.1.0",
  "moonbitstack/moonpool@0.3.4",
  "moonbitstack/moonregex@0.1.5",
