  "moonbitstack/moonkoog/agent",
  "moonbitstack/moonmuse",
  "moonbitstack/moonjson",
  "moonbitstack/moonregex",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/process",
}

import {
  "moonbitstack/moonkoog/agent",
  "moonbitstack/moonmuse",
  "moonbitstack/moonmuse/fake",
  "moonbitstack/moonstate",
  "moonbitlang/async",
} for "test"

warnings = "-29"
