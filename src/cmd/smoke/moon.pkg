// A real-LLM smoke binary: drive an AIAgent with a tool against a live
// OpenAI-compatible endpoint. Native, executable. Reads the key/base/model from
// the environment, so it never carries a secret and is a no-op without a key.
supported_targets = "native"

pkgtype(kind: "executable")

import {
  "moonbitstack/moonmuse/models",
  "moonbitstack/moonmuse/toolbox",
  "moonbitstack/moonkoog/agent",
  "moonbitstack/moonmuse/openai",
  "moonbitlang/async",
  "moonbitlang/core/env",
}
