// The generator behind `#koog.tool`: the functions a package annotates, collected as the tools an
// agent is given. moonx runs it as a dev_build rule; see the README.
supported_targets = "+native+wasm"

pkgtype(kind: "executable")

import {
  "moonbitstack/moonast/quote",
  "moonbitstack/moonast/attr",
  "moonbitstack/moonast/gen",
  "moonbitstack/moonast/cli",
  "moonbitlang/parser/attribute",
  "moonbitlang/async",
  "moonbitlang/core/env",
}
